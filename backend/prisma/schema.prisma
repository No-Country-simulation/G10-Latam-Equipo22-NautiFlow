generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Roles de acceso al back-office y al portal de lancheros.
enum Role {
  ADMIN
  OWNER
  CLIENT

  @@map("Rol")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("EstadoUsuario")
}

/// Estado de verificación del lanchero. Se valida con el equipo de negocio.
enum OwnerStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("EstadoLanchero")
}

enum DocumentType {
  LICENSE
  INSURANCE
  BACKGROUND_CHECK
  PHOTO

  @@map("TipoDocumento")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("EstadoDocumento")
}

enum TripStatus {
  PENDING
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("EstadoViaje")
}

/// Estado del tramo vacío en la bolsa interna de retornos.
enum EmptyLegStatus {
  AVAILABLE
  OFFERED
  ASSIGNED
  CLOSED

  @@map("EstadoTramoVacio")
}

/// Estado de una salida en el catálogo público.
enum EstadoSalida {
  PROGRAMADA
  CANCELADA
  COMPLETADA
}

/// Estado de un tramo dentro de una salida.
enum EstadoTramo {
  DISPONIBLE
  RESERVADO
  CERRADO
  CANCELADO
}

/// Tipo de tramo dentro de una salida.
enum TipoTramo {
  IDA
  VUELTA
}

/// Estado de una solicitud de reserva de un turista sin cuenta.
enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @map("nombre")
  email        String     @unique
  passwordHash String
  role         Role       @default(OWNER) @map("rol")
  status       UserStatus @default(ACTIVE) @map("estado")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner Owner?
  client Cliente?
  ownerReviews Owner[] @relation("OwnerReviewedBy")
  reviewedDocuments OwnerDocument[] @relation("DocumentReviewedBy")
  createdTrips Trip[] @relation("TripCreatedBy")
  createdSalidas Salida[] @relation("SalidaCreatedBy")
  reviewedReservas Reserva[] @relation("ReservaReviewedBy")
  notifications Notification[]

  @@map("usuarios")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("usuarioId")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @map("titulo")
  message   String   @map("mensaje")
  read      Boolean  @default(false) @map("leida")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read, createdAt])
  @@map("notificaciones")
}

model Owner {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @db.Uuid @map("usuarioId")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String?       @map("telefono")
  whatsappPhone String?      @map("whatsappTelefono")
  status       OwnerStatus   @default(PENDING) @map("estado")
  reviewNote   String?       @map("notaRevision")
  reviewedAt   DateTime?
  reviewedById String?       @db.Uuid
  reviewedBy   User?         @relation("OwnerReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  embarcaciones Embarcacion[]
  documents OwnerDocument[]

  @@map("lancheros")
}

/// Estado de verificación de una embarcación frente a la documentación.
enum EstadoEmbarcacion {
  PENDIENTE
  VERIFICADA
  RECHAZADA
  INACTIVA
}

/// Zona de cobertura gestionada por administración.
model Zona {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @unique
  descripcion   String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  embarcaciones EmbarcacionZona[]

  @@map("zonas")
}

/// Embarcación registrada por un lanchero.
model Embarcacion {
  id            String            @id @default(uuid()) @db.Uuid
  propietarioId String            @db.Uuid
  propietario   Owner             @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  nombre        String
  matricula     String            @unique
  capacidad     Int
  descripcion   String?
  estado        EstadoEmbarcacion @default(PENDIENTE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  zonas         EmbarcacionZona[]
  documents OwnerDocument[]
  viajes Trip[]
  reviews Review[]
  emptyLegs EmptyLeg[]
  salidas Salida[]

  @@map("embarcaciones")
}

/// Cobertura M:N entre embarcación y zona.
model EmbarcacionZona {
  embarcacionId String      @db.Uuid
  zonaId        String      @db.Uuid
  embarcacion   Embarcacion @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)
  zona          Zona        @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@id([embarcacionId, zonaId])
  @@map("embarcaciones_zonas")
}

/// Documentos privados. El contenido se guarda en PostgreSQL y solo se entrega con autorización.
model OwnerDocument {
  id           String         @id @default(uuid()) @db.Uuid
  ownerId      String         @db.Uuid @map("lancheroId")
  owner        Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boatId       String?        @db.Uuid @map("embarcacionId")
  boat         Embarcacion?   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  type         DocumentType   @map("tipo")
  status       DocumentStatus @default(PENDING) @map("estado")
  filename     String         @map("nombreArchivo")
  mimeType     String
  size         Int
  content      Bytes
  reviewNote   String?        @map("notaRevision")
  reviewedAt   DateTime?
  reviewedById String?        @db.Uuid
  reviewedBy   User?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([ownerId, type])
  @@index([boatId, type])
  @@map("documentos_lanchero")
}

/// Cliente de la agencia; registro de contacto sin cuenta. userId se conserva como vínculo legado.
model Cliente {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre    String
  telefono  String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  viajes    Trip[]

  @@map("clientes")
}

model Trip {
  id             String     @id @default(uuid()) @db.Uuid
  clienteId      String     @db.Uuid
  cliente        Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  embarcacionId  String?    @db.Uuid
  embarcacion    Embarcacion? @relation(fields: [embarcacionId], references: [id], onDelete: Restrict)
  createdById    String     @db.Uuid
  createdBy      User       @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  scheduledAt    DateTime @map("fechaHora")
  passengerCount Int      @map("cantidadPasajeros")
  origin         String   @map("origen")
  destination    String   @map("destino")
  status         TripStatus @default(PENDING) @map("estado")
  salidaId       String?    @db.Uuid
  salida         Salida?    @relation(fields: [salidaId], references: [id], onDelete: SetNull)
  tramoId        String?    @db.Uuid
  tramo          Tramo?     @relation(fields: [tramoId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  reviewToken    ReviewToken?
  review         Review?
  emptyLegs      EmptyLeg[]
  reserva        Reserva?

  @@index([status, scheduledAt])
  @@index([embarcacionId, scheduledAt])
  @@index([tramoId])
  @@map("viajes")
}

/// Salida publicable en el catálogo de viajes.
model Salida {
  id             String       @id @default(uuid()) @db.Uuid
  embarcacionId  String       @db.Uuid
  embarcacion    Embarcacion  @relation(fields: [embarcacionId], references: [id], onDelete: Restrict)
  createdById    String       @db.Uuid
  createdBy      User         @relation("SalidaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  fechaSalida    DateTime
  estado         EstadoSalida @default(PROGRAMADA)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tramos Tramo[]
  trips  Trip[]
  reservas Reserva[]

  @@index([estado, fechaSalida])
  @@map("salidas")
}

/// Tramo (ida/vuelta) dentro de una salida; precio y cupo por tramo.
model Tramo {
  id             String       @id @default(uuid()) @db.Uuid
  salidaId       String       @db.Uuid
  salida         Salida       @relation(fields: [salidaId], references: [id], onDelete: Cascade)
  tipo           TipoTramo
  origen         String
  destino        String
  fechaHora      DateTime
  cupo           Int
  precioCentavos Int
  sinTuristas    Boolean      @default(false)
  estado         EstadoTramo @default(DISPONIBLE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trips Trip[]
  reservas Reserva[]

  @@index([salidaId, tipo])
  @@index([estado, fechaHora])
  @@map("tramos")
}

/// Tramo de regreso sin pasajeros que nace de un viaje de ida.
model EmptyLeg {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String?        @db.Uuid @map("viajeId")
  trip          Trip?          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  embarcacionId String         @db.Uuid
  embarcacion   Embarcacion    @relation(fields: [embarcacionId], references: [id], onDelete: Restrict)
  origin        String   @map("origen")
  destination   String   @map("destino")
  scheduledAt   DateTime @map("fechaHora")
  status        EmptyLegStatus @default(AVAILABLE) @map("estado")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([tripId])
  @@map("tramos_vacios")
}

model ReviewToken {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @unique @db.Uuid @map("viajeId")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("tokens_resena")
}

model Review {
  id             String      @id @default(uuid()) @db.Uuid
  tripId         String      @unique @db.Uuid @map("viajeId")
  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  embarcacionId String?     @db.Uuid
  embarcacion    Embarcacion? @relation(fields: [embarcacionId], references: [id], onDelete: SetNull)
  rating        Int         @map("puntuacion")
  comment       String?     @map("comentario")
  createdAt     DateTime    @default(now())

  @@map("resenas")
}

/// Solicitud de reserva de un tramo del catálogo, hecha por un turista sin cuenta.
model Reserva {
  id                String        @id @default(uuid()) @db.Uuid
  tramoId           String        @db.Uuid
  tramo             Tramo         @relation(fields: [tramoId], references: [id], onDelete: Restrict)
  salidaId          String        @db.Uuid
  salida            Salida        @relation(fields: [salidaId], references: [id], onDelete: Restrict)
  nombre            String
  telefono          String
  email             String?
  cantidadPasajeros Int
  mensaje           String?
  /// Snapshot del tramo al momento de solicitar.
  origen            String
  destino           String
  fechaHora         DateTime
  precioCentavos    Int
  estado            EstadoReserva @default(PENDIENTE)
  /// true cuando la confirmación descontó cupo del tramo.
  cupoDescontado    Boolean       @default(false)
  adminNote         String?
  reviewedAt        DateTime?
  reviewedById      String?       @db.Uuid
  reviewedBy        User?         @relation("ReservaReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  tripId            String?       @unique @db.Uuid
  trip              Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([estado, createdAt])
  @@index([tramoId, estado])
  @@map("reservas")
}
