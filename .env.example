# Copiar como .env en la raíz y completar los valores.
# Nunca subir .env al repositorio.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=nautiflow
POSTGRES_PASSWORD=nautiflow
POSTGRES_DB=nautiflow

# --- Backend ---
PORT=3000
# Desde el host (backend fuera de Docker). Docker Compose la sobreescribe con host "db".
DATABASE_URL=postgresql://nautiflow:nautiflow@localhost:5432/nautiflow
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Límite de intentos por IP para login y registros (ventana en segundos).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Ventana (en horas) para detectar viajes superpuestos de una misma embarcación.
TRIP_SLOT_HOURS=2
# URL pública que se incluirá en enlaces de reseña enviados al cliente.
PUBLIC_APP_URL=http://localhost:5173

# --- Seed de desarrollo (opcional; si falta, el seed se omite) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Frontend ---
# URL base de la API tal como la ve el navegador.
VITE_API_URL=http://localhost:3000/api/v1
