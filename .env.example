# Copiar como .env en la raíz y completar los valores.
# Nunca subir .env al repositorio.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=nautiflow
POSTGRES_PASSWORD=nautiflow
POSTGRES_DB=nautiflow

# --- Backend ---
PORT=3000
# Desde el host (backend fuera de Docker). Docker Compose la sobreescribe con host "db".
DATABASE_URL=postgresql://nautiflow:nautiflow@localhost:5432/nautiflow
JWT_SECRET=cambieme-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# --- Seed de desarrollo (opcional; si falta, el seed se omite) ---
SEED_ADMIN_EMAIL=admin@nautiflow.local
SEED_ADMIN_PASSWORD=Admin1234!

# --- Frontend ---
# URL base de la API tal como la ve el navegador.
VITE_API_URL=http://localhost:3000/api/v1
